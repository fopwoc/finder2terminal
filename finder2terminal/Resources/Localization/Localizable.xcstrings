    "profile_editor.arguments.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One item per line. Put {executable} or {targets} on its own line to change the command order. Omitted tokens use the default executable → arguments → targets order."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один элемент на строку. Поместите {executable} или {targets} в отдельную строку, чтобы изменить порядок команды. Без токенов используется порядок: исполняемый файл → аргументы → цели."
          }
        }
      }
    },
