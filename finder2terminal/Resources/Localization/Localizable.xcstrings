    "finder_actions.delete_confirmation.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes every Finder workflow, temporary command script, profile, and saved app setting. This cannot be undone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены все быстрые действия Finder, временные командные сценарии, профили и сохранённые настройки приложения. Это действие нельзя отменить."
          }
        }
      }
    },
